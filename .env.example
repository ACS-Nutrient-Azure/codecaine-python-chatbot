# Chatbot Service 환경변수 예시
# cp .env.example .env 후 실제 값으로 채울 것

# ── AWS 기본 설정 ────────────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
# ECS Task Role 사용 시 아래 두 줄 비워둘 것 (권장)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── S3 — 챗봇 대화 저장 (필수) ───────────────────────────────────────────────
S3_BUCKET_NAME=your-chatbot-bucket

# ── AWS Cognito — JWT 인증 (필수) ────────────────────────────────────────────
COGNITO_USER_POOL_ID=ap-northeast-2_xxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxx
JWT_ALGORITHM=RS256

# ── Supervisor Agent (필수) ───────────────────────────────────────────────────
SUPERVISOR_AGENT_ARN=arn:aws:bedrock-agentcore:ap-northeast-2:xxxxx:agent-runtime/xxxxx

# ── User Service URL (필수) ───────────────────────────────────────────────────
# VPC 내부 통신 URL (Service Discovery 또는 ALB 내부 DNS)
# 경로 없이 base URL만 설정 (코드에서 /api/codef/health-data/{cognito_id} 자동 추가)
USER_SERVICE_URL=http://user-service.internal:8000

# ── Redis (필수) ──────────────────────────────────────────────────────────────
REDIS_HOST=your-redis.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── PostgreSQL (필수 — 분석 히스토리 조회용) ──────────────────────────────────
DB_HOST=your-rds.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=chatbot_db
DB_USER=chatbot_user
DB_PASSWORD=your-db-password

# ── 개발 옵션 ─────────────────────────────────────────────────────────────────
# CORS 허용 도메인 (운영: 프론트엔드 도메인, 개발: *)
ALLOWED_ORIGINS=*
# true 설정 시 인증 검증 건너뜀 (개발 환경 전용, 운영에서는 false)
SKIP_AUTH=false
