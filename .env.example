# Chatbot Service 환경변수 예시
# cp .env.example .env 후 실제 값으로 채울 것

# ── AWS DynamoDB (필수) ───────────────────────────────────────────────────────
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=ChatbotData
# 로컬 DynamoDB 사용 시 엔드포인트 지정. AWS 실제 서비스 사용 시 비워둘 것
DYNAMODB_ENDPOINT_URL=

# ── S3 — 챗봇 대화 저장 (선택) ───────────────────────────────────────────────
S3_BUCKET_NAME=

# ── AWS Cognito — JWT 인증 (필수) ────────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
JWT_ALGORITHM=RS256

# ── 개발 옵션 ─────────────────────────────────────────────────────────────────
# true 설정 시 인증 검증 건너뜀 (개발 환경 전용)
SKIP_AUTH=false

# ── Supervisor Agent ARN ──────────────────────────────────────────────────────
SUPERVISOR_AGENT_ARN=placeholder

# ── User Service URL ──────────────────────────────────────────────────────────
USER_SERVICE_URL=http://localhost:8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
